# =============================================================================
#  Zambia Election Terminal 2026 — environment template
# -----------------------------------------------------------------------------
#  The DEMO build requires NO environment variables (all data is in-browser).
#  These variables apply when wiring a real backend (see docs/DATA_ARCHITECTURE.md
#  and docs/API.md). Copy to `.env` / `.env.local` and fill in.
# =============================================================================

# ---- Frontend (Vite exposes only VITE_* to the client) ----------------------
# Base URL of the results/model API (FastAPI service). Empty = use in-browser store.
VITE_API_BASE_URL=

# Live-update channel for the client (Server-Sent Events or WebSocket URL).
VITE_LIVE_FEED_URL=

# Map provider token (only if you replace the built-in tile cartogram with Mapbox).
VITE_MAPBOX_TOKEN=

# Monte Carlo defaults (optional overrides).
VITE_MC_ITERATIONS=4000
VITE_MC_SEED=20260813

# ---- Backend (FastAPI / model service — NOT exposed to the client) ----------
# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/zambia_election

# Auth for the admin/manual-entry and ingestion endpoints.
ADMIN_JWT_SECRET=change-me
INGEST_API_KEY=change-me

# Official ECZ results feed (URL + credentials), where legally/technically available.
ECZ_FEED_URL=
ECZ_FEED_API_KEY=

# Model run configuration.
FORECAST_MC_ITERATIONS=10000
FORECAST_SEED=20260813
