# Copy to .env.local for local development. Never commit .env.local.
#
# Both values come from Supabase → Project Settings → API.
# The anon key is public by design (it ships in the browser bundle); Row Level
# Security in supabase/migrations/ is what protects data.
# NEVER put the service_role key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Show the demo listings alongside real ones (handy while the marketplace is
# empty; switch off before launch).
VITE_SHOW_SEED_LISTINGS=true
